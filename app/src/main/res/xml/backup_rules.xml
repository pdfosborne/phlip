<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-API-31 fullBackupContent rules. `allowBackup="false"` already disables
  Auto Backup; these exclusions keep secret stores and host data out if a
  library or merger ever re-enables backup.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="ash_cloudflare_secure_v2.xml"/>
    <exclude domain="sharedpref" path="ash_host_at_rest_v1.xml"/>
    <exclude domain="sharedpref" path="ash_approved_networks_v1.xml"/>
    <exclude domain="file" path="servers.json"/>
</full-backup-content>
