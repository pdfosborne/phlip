<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The web client is served from the secure appassets.androidplatform.net origin
         but opens plain ws:// sockets to whichever LAN hosts the user adds — those
         phones' own DrServer has no TLS cert to offer, so cleartext must be allowed
         broadly rather than to a fixed set of domains. -->
    <base-config cleartextTrafficPermitted="true"/>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
