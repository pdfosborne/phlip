<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f8f9fa">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="@null"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/layoutClientError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvClientError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/client_error_title"
            android:textSize="18sp"
            android:textColor="#c0392b"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnRetryClient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/client_error_retry"
            android:textSize="14sp"
            android:textColor="#14120f"
            android:backgroundTint="#eae8e1"/>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressStarting"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"/>

    <!-- In-activity boot: full HQ logo while the WebView loads. -->
    <ImageView
        android:id="@+id/splashLogo"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="center"
        android:contentDescription="@string/app_name"
        android:padding="24dp"
        android:scaleType="fitCenter"
        android:src="@drawable/splash_logo_full"
        android:visibility="gone"/>

    <!-- wrap_content + gravity=top|end: a full-width transparent Toolbar would
         sit on top of (and swallow touches meant for) the WebView's own header
         underneath, including its hamburger button on the left. Shrinking the
         Toolbar to just its overflow icon lets everything else pass through. -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="wrap_content"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="top|end"
        android:background="@android:color/transparent"
        app:theme="@style/ThemeOverlay.AppCompat.Light"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"/>

</FrameLayout>
